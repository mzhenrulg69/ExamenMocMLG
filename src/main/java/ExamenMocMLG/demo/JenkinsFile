pipeline {
    agent any

    // Definir constante de versión
    environment {
        PROJECT_VERSION = '1.0.0'
    }

    stages {
        // Stage 1: Checkout del código
        stage('Checkout') {
            steps {
                echo 'Realizando checkout del proyecto...'
                checkout scm
            }
        }

        // Stage 2: Compilación
        stage('Build') {
            steps {
                echo 'Limpiando y compilando el proyecto...'
                sh 'mvn clean compile'
            }
        }

        // Stage 3: Ejecución de tests
        stage('Test') {
            steps {
                echo 'Ejecutando tests...'
                sh 'mvn test'
            }
        }

        // Stage 4: Empaquetado
        stage('Package') {
            steps {
                echo 'Empaquetando proyecto...'
                sh 'mvn package -DskipTests'
            }
        }

        // Stage 5: Mover JAR
        stage('Move jar') {
            steps {
                script {
                    echo 'Eliminando directorio versiones...'
                    // Eliminar directorio si existe
                    sh '''
                        if [ -d "versiones" ]; then
                            rm -rf versiones
                        fi
                    '''
                }
            }
            post {
                success {
                    echo 'Se crea el directorio versiones con la última versión de la api'
                    sh '''
                        # Crear directorio versiones
                        mkdir -p versiones

                        # Copiar el JAR que NO es original
                        # Buscar el JAR con la versión en el nombre
                        find target -name "*${PROJECT_VERSION}*.jar" ! -name "*original*" -exec cp {} versiones/ \\;

                        # O alternativa específica
                        cp target/*${PROJECT_VERSION}.jar versiones/
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline completada'
        }
        failure {
            echo 'Pipeline falló'
        }
        success {
            echo 'Pipeline exitosa'
        }
    }
}